# Every variable must be declared. An empty source path turns that source off on purpose.
# At least one source must be on.

# Claude Code projects directory (real install: ~/.claude/projects)
CLAUDE_LOGS_DIR=./fixtures/session-logs-dataset/claude-code/projects
# Codex sessions directory (real install: ~/.codex/sessions)
CODEX_LOGS_DIR=./fixtures/session-logs-dataset/codex/sessions
# Cursor state database (synthetic fixture; generate with `npm run gen:cursor`)
CURSOR_DB_PATH=./fixtures/cursor/state.vscdb

# Claude Code OTel events (JSONL). Not a source: used only to cross-check our prices.
# Empty turns the reconciliation panel off.
OTEL_EVENTS_PATH=./fixtures/session-logs-dataset/otel/claude-code-events.jsonl

# Local store for normalized events and snapshots (created if missing, git-ignored)
DATA_DIR=./data

# Loopback only: 127.0.0.1, ::1 or localhost
HOST=127.0.0.1
PORT=4680
